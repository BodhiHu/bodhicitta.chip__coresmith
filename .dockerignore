# Build context exclusions for Dockerfile_ubuntu2404_arm64.
# Keep source, specs, tests, scripts and the pinned PDK version file.
.git
.gitignore
.pdk
venv
**/__pycache__
**/.pytest_cache
**/*.pyc
designs/cdna5-m1/sim/build
designs/cdna5-m1/rocm/build
designs/cdna5-m1/syn/*/*_netlist.v
designs/cdna5-m1/syn/*/*.json
designs/cdna5-m1/syn/*/yosys.log
designs/cdna5-m1/syn/*/stdout*.log
designs/cdna5-m1/syn/*/synth.ys
designs/cdna5-m1/pnr/*/*.gds
designs/cdna5-m1/pnr/*/*.def
designs/cdna5-m1/pnr/*/*_pnr.v
designs/cdna5-m1/pnr/*/*_pwr.v
designs/cdna5-m1/pnr/*/route_guide.guide
designs/cdna5-m1/pnr/*/*.log
designs/cdna5-m1/pnr/*/*.cdl
designs/cdna5-m1/pnr/*/*.cir
designs/cdna5-m1/pnr/*/*.spice
designs/cdna5-m1/pnr/*/*.lvsdb
designs/cdna5-m1/project/.coresmith
designs/cdna5-m1/*.ext
.env.local
.env

# Developer/IDE noise (keep the design RTL/tb/syn/pnr files above).
.vscode/
.idea/
.cursor/
.claude/
.github/
**/node_modules/
**/*.egg-info/
orchestrator/.venv/
.DS_Store
Thumbs.db
.mcp.json
